{
  "name": "@grundstein/prepare-static-files",
  "version": "0.0.15",
  "description": "optimize and compress static files for hosting.",
  "type": "module",
  "bin": {
    "prepare-static-files": "src/bin.js"
  },
  "main": "src/index.js",
  "files": [
    "src"
  ],
  "scripts": {
    "dev": "grundstein-server --dir ./docs --port 8002 --cors '*'",
    "optimize": "src/bin.js --dir docs --no-compress",
    "compress": "src/bin.js --dir docs --no-optimize-images",
    "build": "src/bin.js --dir docs",
    "rebuild": "npm run cleanup && src/bin.js --dir docs",
    "format": "f -w",
    "cleanup": "rm -f docs/*.webp docs/*.webm docs/*.gz docs/*.ogg docs/sample1.mp4 docs/*.mp3",
    "test": "t"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grundstein/prepare-static-files.git"
  },
  "author": "TheSystemCollective",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/grundstein/prepare-static-files/issues"
  },
  "homepage": "https://github.com/grundstein/prepare-static-files#readme",
  "dependencies": {
    "@magic/cli": "0.0.55",
    "@magic/fs": "0.0.40",
    "@magic/log": "0.1.23",
    "@magic/mime-types": "0.0.24",
    "@magic/types": "0.1.39",
    "fluent-ffmpeg": "2.1.3",
    "node-zopfli-es": "2.0.6",
    "plyo": "0.0.1",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@grundstein/gss": "0.0.14",
    "@magic/format": "0.0.75",
    "@magic/test": "0.3.28"
  },
  "contributors": [
    {
      "name": "jascha ehrenreich",
      "github": "jaeh"
    },
    {
      "name": "daniela weiss",
      "github": "mslitto"
    }
  ],
  "allowScripts": {
    "canvas@3.2.3": true,
    "node-zopfli-es@2.0.6": true
  }
}
